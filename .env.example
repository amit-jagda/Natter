# =============================================================================
# AI Voice Agent Platform - Environment Configuration Example
# Copy this file to '.env' and populate with your local or production credentials.
# =============================================================================

# --- Application Runtime & Security ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Voice Agent Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-random-32-char-string-in-production
JWT_SECRET_KEY=replace-with-a-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- PostgreSQL Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_ai_platform

# Optional Database Overrides (if using external managed RDS or Supabase)
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@host:5432/db
# DATABASE_SYNC_URL_OVERRIDE=postgresql://user:pass@host:5432/db

# --- Redis & Arq Background Worker ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Voice Engine Provider Boundaries ---
# STT: 'google', 'deepgram', 'mock'
STT_PROVIDER=google

# TTS: 'piper', 'kyutai', 'gtts', 'mock'
TTS_PROVIDER=piper

# LLM: 'gemini', 'ollama', 'openai', 'anthropic', 'mock'
LLM_PROVIDER=gemini

# Telephony: 'mock', 'exotel', 'plivo', 'twilio'
TELEPHONY_PROVIDER=mock

# Voice Orchestration Framework: 'adapter', 'livekit', 'pipecat'
VOICE_FRAMEWORK=adapter

# --- External AI & Model Provider Credentials ---
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# --- Telephony Provider Credentials (Phase 1) ---
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SUBDOMAIN=
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Monitoring & Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Frontend Environment Variables ---
VITE_API_URL=http://localhost:8000

# --- External Connectors (Google Calendar, Sheets, Radicale CalDAV) ---
# 1. Google Calendar Connector (Doctor Calendar Sync)
GOOGLE_CALENDAR_ID=your_doctor_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=voice-agent@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=

# 2. Google Sheets Connector (Receptionist & Patient Records)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_TAB_NAME=OPD_Appointments_2026
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# 3. Radicale CalDAV Connector (Self-Hosted Private Calendar)
RADICALE_SERVER_URL=http://localhost:5232
RADICALE_USERNAME=hospital_admin
RADICALE_PASSWORD=hospital_secure_password
RADICALE_CALENDAR_PATH=/hospital_admin/doctor_appointments/
RADICALE_IGNORE_SSL=true

