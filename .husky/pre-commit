#!/usr/bin/env sh

echo ""
echo "🔍 [pre-commit] Checking frontend build & TypeScript..."
echo ""

npm run build --prefix frontend
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "❌ [pre-commit] Commit BLOCKED: TypeScript or Vite build errors found!"
  echo "👉 Please fix the errors above before committing."
  echo ""
  exit 1
fi

echo "✅ [pre-commit] Frontend checks passed!"
echo ""

STAGED_BACKEND_PY=$(git diff --cached --name-only --diff-filter=ACMR -- backend/ | grep '\.py$' | grep -v '^backend/tests/' || true)

if [ -n "$STAGED_BACKEND_PY" ]; then
  echo "🔍 [pre-commit] Running Ruff on staged backend Python files (excluding tests/)..."
  echo ""

  RUFF_BIN=""
  USE_DOCKER=0

  # 1. Prefer running Ruff inside the active Docker container
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^voice-ai-backend$'; then
    USE_DOCKER=1
  # 2. Fall back to local virtualenv or system PATH if available
  elif [ -x "backend/.venv/Scripts/ruff.exe" ]; then
    RUFF_BIN="backend/.venv/Scripts/ruff.exe"
  elif [ -x "backend/.venv/bin/ruff" ]; then
    RUFF_BIN="backend/.venv/bin/ruff"
  elif command -v ruff >/dev/null 2>&1; then
    RUFF_BIN="ruff"
  fi

  if [ "$USE_DOCKER" -eq 1 ]; then
    echo "🐳 [pre-commit] Running Ruff via Docker container 'voice-ai-backend'..."
    DOCKER_FILES=$(printf '%s\n' "$STAGED_BACKEND_PY" | sed 's|^backend/||')
    MSYS_NO_PATHCONV=1 docker exec -i voice-ai-backend ruff check --config pyproject.toml $DOCKER_FILES
    RUFF_STATUS=$?
  elif [ -n "$RUFF_BIN" ]; then
    printf '%s\n' "$STAGED_BACKEND_PY" | xargs "$RUFF_BIN" check --config backend/pyproject.toml
    RUFF_STATUS=$?
  else
    echo "❌ [pre-commit] Commit BLOCKED: Ruff not found."
    echo "👉 Ensure the 'voice-ai-backend' Docker container is running (docker compose up -d),"
    echo "   or install ruff locally in PATH / backend/.venv."
    echo ""
    exit 1
  fi

  if [ $RUFF_STATUS -ne 0 ]; then
    echo ""
    echo "❌ [pre-commit] Commit BLOCKED: Ruff lint errors found in staged backend files!"
    echo "👉 Fix the errors above (or run: $RUFF_BIN check --fix --config backend/pyproject.toml <files>) before committing."
    echo ""
    exit 1
  fi

  echo "✅ [pre-commit] Backend Ruff checks passed!"
  echo ""
fi

exit 0
