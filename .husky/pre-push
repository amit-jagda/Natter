#!/usr/bin/env sh

echo ""
echo "=========================================================="
echo "🚀 [pre-push] Running pre-push validation (Build & Tests)..."
echo "=========================================================="
echo ""

echo "🔨 Step 1: Building frontend (TypeScript & Vite)..."
npm run build --prefix frontend
FRONTEND_STATUS=$?

if [ $FRONTEND_STATUS -ne 0 ]; then
  echo ""
  echo "❌ [pre-push] Push BLOCKED: Frontend build failed!"
  echo "👉 Please fix the TypeScript / bundle build errors before pushing."
  echo ""
  exit 1
fi

echo "✅ Frontend build passed successfully!"
echo ""

if command -v python >/dev/null 2>&1; then
  echo "🧪 Step 2: Running backend unit tests..."
  python backend/tests/run_unit_tests.py
  BACKEND_STATUS=$?
  if [ $BACKEND_STATUS -ne 0 ]; then
    echo ""
    echo "❌ [pre-push] Push BLOCKED: Backend unit tests failed!"
    echo "👉 Please fix the backend test errors before pushing."
    echo ""
    exit 1
  fi
  echo "✅ Backend tests passed successfully!"
  echo ""
fi

echo "=========================================================="
echo "🎉 [pre-push] All checks passed! Proceeding with git push."
echo "=========================================================="
echo ""
exit 0
